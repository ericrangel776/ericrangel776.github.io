# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Contact form email delivery (SMTP) ---
# Gmail example: requires a Google "App Password", NOT your normal password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rangeleric776@gmail.com
SMTP_PASS=your-16-character-app-password

# Where contact-form messages get delivered to. Defaults to SMTP_USER if omitted.
CONTACT_TO_EMAIL=rangeleric776@gmail.com

# --- Server ---
# Port the site + API are served on. Defaults to 8791 if omitted.
PORT=8791

# If SMTP_HOST/SMTP_USER/SMTP_PASS are left unset, the contact form still
# works end-to-end — it just logs the message to the server console
# instead of actually emailing it ("dry run"). Useful for local dev.
